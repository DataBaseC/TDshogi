# 依赖
node_modules/

# 运行时数据（棋谱/会话/评级/账号）— 服务器运行自动生成
data/
!data/.gitkeep

# 测试与工具残留
.playwright-cli/
.codebuddy/
*.log
.pack-tmp/
.verify-tmp/
.tmpdata*
.tmp-*/

# 部署上传区（生成物：内容 = src/public 等的副本，由 scripts/pack.js 生成）
# 不入主库——否则 src/public 会在仓库里出现两份
github-upload/

# 部署打包产物（dist/tdshogi-deploy-v*.zip）
# 同样是 src/public 的副本，体积不小且每次打包都变——不入库
dist/

# §M1 拆分期间的校验基线（临时文件，拆完即删）
.tmp-proto-*.txt

# 系统文件
.DS_Store
Thumbs.db
